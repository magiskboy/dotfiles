source "${${(%):-%N}:A:h}/libs.zsh"

ZSH_THEME="robbyrussell"

plugins=(
  git
  aws
  helm
  kubectl
  yarn
  zoxide
  eza
  fzf
  zellij
  zsh-autosuggestions
  zsh-syntax-highlighting
)

export EDITOR=nvim
export PATH=$PATH:$GOROOT/bin:$GOPATH/bin:/opt/homebrew/bin:/use/local/bin:$HOME/.local/bin
[ -s "$HOME/.local.env" ] && \. "$HOME/.local.env"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export GOROOT=$HOME/.local/go
export GOPATH=$HOME/Work/go

[ -s "$HOME/.cargo/env" ] && \. "$HOME/.cargo/env"

# Canonical CLI names across macOS / Linux (fd, bat, open, …)
source "${${(%):-%N}:A:h}/cli-compat.zsh"

zsh_load_plugins
zsh_load_theme

# ripgrep + fzf (folders: ~/.dotfiles/{ripgrep,fzf})
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"
[[ -r ${${(%):-%N}:A:h:h}/fzf/fzf.zsh ]] && source "${${(%):-%N}:A:h:h}/fzf/fzf.zsh"

